generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                 String    @id @default(cuid())
  clerkOrgId         String    @unique
  name               String
  plan               String    @default("free")
  isSuspended        Boolean   @default(false)
  suspendedAt        DateTime?
  suspendedBy        String?
  suspensionReason   String?
  createdAt          DateTime  @default(now())

  members                OrganizationMember[]
  invites                OrganizationInvite[]
  workspaces             Workspace[]
  contacts               Contact[]
  deals                  Deal[]
  activities             Activity[]
  tasks                  Task[]
  tags                   Tag[]
  customFieldDefinitions CustomFieldDefinition[]
  documents              Document[]
  buyerProfiles          BuyerProfile[]
  aiInsights             AiInsight[]
}

model OrganizationMember {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clerkUserId    String
  email          String
  firstName      String?
  lastName       String?
  imageUrl       String?
  role           String    @default("member")
  joinedAt       DateTime  @default(now())
  lastActiveAt   DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@unique([organizationId, clerkUserId])
  @@index([organizationId])
  @@index([clerkUserId])
}

model OrganizationInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      String
  email          String
  role           String       @default("member")
  status         String       @default("pending")
  clerkInviteId  String?
  expiresAt      DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([clerkInviteId])
}

model Workspace {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  slug               String
  color              String       @default("#1E293B")
  professionTemplate String
  webhookToken       String       @unique
  sortOrder          Int          @default(0)
  createdAt          DateTime     @default(now())

  stages                 Stage[]
  contactWorkspaces      ContactWorkspace[]
  deals                  Deal[]
  activities             Activity[]
  tasks                  Task[]
  customFieldDefinitions CustomFieldDefinition[]
  documents              Document[]
  automations            StageAutomation[]
  taskTemplates          TaskTemplate[]
  savedViews             SavedView[]
  emailTemplates         EmailTemplate[]

  @@unique([organizationId, slug])
}

model Contact {
  id                      String         @id @default(cuid())
  organizationId          String
  organization            Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName               String
  lastName                String?
  email                   String?
  phone                   String?
  city                    String?
  state                   String?
  birthday                DateTime?
  homeAnniversary         DateTime?
  source                  String?
  sourceDetail            String?
  temperature             String         @default("warm")
  notes                   String?        @db.Text
  lifecycleStage          LifecycleStage @default(LEAD)
  lifecycleStageEnteredAt DateTime       @default(now())
  lastContactAt           DateTime?
  lifetimeVolumeCents     BigInt?
  pipelineEnteredAt       DateTime?
  ownerClerkUserId        String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  contactWorkspaces ContactWorkspace[]
  contactTags       ContactTag[]
  deals             Deal[]
  activities        Activity[]
  tasks             Task[]
  documents         Document[]
  buyerProfile      BuyerProfile?
  aiInsights        AiInsight[]

  @@index([organizationId])
  @@index([organizationId, lifecycleStage])
  @@index([organizationId, lastContactAt])
  @@index([organizationId, ownerClerkUserId])
}

model ContactWorkspace {
  id          String    @id @default(cuid())
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  roleLabel   String?
  addedAt     DateTime  @default(now())

  @@unique([contactId, workspaceId])
}

model Stage {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  sortOrder       Int
  isTerminal      Boolean   @default(false)
  terminalOutcome String?

  deals      Deal[]
  automation StageAutomation?
}

model StageAutomation {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  stageId        String   @unique
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stage     Stage                @relation(fields: [stageId], references: [id], onDelete: Cascade)
  tasks     StageAutomationTask[]

  @@index([organizationId])
  @@index([workspaceId])
}

model StageAutomationTask {
  id                    String   @id @default(cuid())
  automationId          String
  title                 String
  description           String?
  taskType              String   @default("other")
  priority              String   @default("medium")
  dueOffsetDays         Int      @default(0)
  reminderOffsetMinutes Int?
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())

  automation StageAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

model Deal {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId       String
  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId         String?
  contact           Contact?     @relation(fields: [contactId], references: [id])
  stageId           String
  stage             Stage        @relation(fields: [stageId], references: [id])
  title             String
  value             Decimal?     @db.Decimal(12, 2)
  expectedCloseDate DateTime?
  status            String       @default("open")
  movedToStageAt    DateTime     @default(now())
  notes             String?      @db.Text
  ownerClerkUserId  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  activities Activity[]
  tasks      Task[]
  documents  Document[]

  @@index([organizationId, workspaceId])
  @@index([organizationId, ownerClerkUserId])
}

model Activity {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId          String?
  workspace            Workspace?   @relation(fields: [workspaceId], references: [id])
  contactId            String?
  contact              Contact?     @relation(fields: [contactId], references: [id])
  dealId               String?
  deal                 Deal?        @relation(fields: [dealId], references: [id])
  type                 String
  body                 String       @db.Text
  occurredAt           DateTime     @default(now())
  createdByClerkUserId String?
  createdAt            DateTime     @default(now())

  @@index([organizationId])
  @@index([contactId])
  @@index([dealId])
}

model Task {
  id                    String       @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId           String?
  workspace             Workspace?   @relation(fields: [workspaceId], references: [id])
  contactId             String?
  contact               Contact?     @relation(fields: [contactId], references: [id])
  dealId                String?
  deal                  Deal?        @relation(fields: [dealId], references: [id])
  title                 String
  description           String?      @db.Text
  priority              String       @default("medium")
  taskType              String?
  dueAt                 DateTime?
  reminderAt            DateTime?
  completedAt           DateTime?
  assignedToClerkUserId String?
  createdAt             DateTime     @default(now())

  @@index([organizationId, dueAt])
  @@index([organizationId, assignedToClerkUserId])
}

model Tag {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  color           String       @default("#64748B")
  professionScope String?

  contactTags ContactTag[]

  @@unique([organizationId, name])
}

model ContactTag {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model CustomFieldDefinition {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId    String?
  workspace      Workspace?   @relation(fields: [workspaceId], references: [id])
  entityType     String
  fieldKey       String
  fieldLabel     String
  fieldType      String
  options        Json?
  isRequired     Boolean      @default(false)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  values CustomFieldValue[]

  @@unique([organizationId, workspaceId, entityType, fieldKey])
}

model CustomFieldValue {
  id           String                @id @default(cuid())
  definitionId String
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  entityType   String
  entityId     String
  value        Json

  @@unique([definitionId, entityId])
  @@index([entityType, entityId])
}

model Document {
  id                    String        @id @default(cuid())
  organizationId        String
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId           String?
  workspace             Workspace?    @relation(fields: [workspaceId], references: [id])
  contactId             String?
  contact               Contact?      @relation(fields: [contactId], references: [id])
  dealId                String?
  deal                  Deal?         @relation(fields: [dealId], references: [id])
  r2Key                 String        @unique
  fileName              String
  fileSize              Int
  mimeType              String
  uploadedByClerkUserId String?
  uploadedAt            DateTime      @default(now())

  @@index([organizationId])
  @@index([contactId])
  @@index([dealId])
}

model TaskTemplate {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String?
  name           String
  description    String?
  appliesTo      String   @default("both")
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String

  workspace Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskTemplateItem[]

  @@index([organizationId])
  @@index([workspaceId])
}

model PlatformAdmin {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String
  grantedBy   String?
  grantedAt   DateTime @default(now())
  isActive    Boolean  @default(true)

  @@index([clerkUserId])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  clerkUserId String
  email      String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([clerkUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model EmailTemplate {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String?
  name           String
  description    String?
  subject        String
  body           String    @db.Text
  appliesTo      String    @default("contact")
  sortOrder      Int       @default(0)
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workspaceId])
}

model OAuthAccount {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  provider       String
  email          String
  accessToken    String    @db.Text
  refreshToken   String?   @db.Text
  tokenExpiresAt DateTime?
  scopes         String[]
  isActive       Boolean   @default(true)
  connectedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, provider])
  @@index([organizationId])
}

model SavedView {
  id             String    @id @default(cuid())
  organizationId String
  workspaceId    String?
  entityType     String
  name           String
  scope          String    @default("personal")
  filters        Json
  sortBy         String?
  sortDirection  String?
  createdBy      String
  isPinned       Boolean   @default(false)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType])
  @@index([workspaceId])
  @@index([createdBy])
}

model TaskTemplateItem {
  id                    String   @id @default(cuid())
  templateId            String
  title                 String
  description           String?
  taskType              String   @default("other")
  priority              String   @default("medium")
  dueOffsetDays         Int      @default(0)
  reminderOffsetMinutes Int?
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())

  template TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

// ── Lifecycle & AI enums ──────────────────────────────────────────────────────

enum LifecycleStage {
  LEAD
  WORKING
  ACTIVE_BUYER
  ACTIVE_SELLER
  PAST_CLIENT
  SPHERE
  INACTIVE
  TRASH
}

enum InsightType {
  RE_ENGAGEMENT
  ANNIVERSARY
  REPLY_RECEIVED
  NEW_LISTING_MATCH
  PRICE_DROP_ALERT
  STALE_DEAL
  CLOSING_TODAY
  PREAPPROVAL_EXPIRING
}

enum InsightPriority {
  HIGH
  NORMAL
  LOW
}

enum InsightStatus {
  PENDING
  SENT
  SKIPPED
  EXPIRED
  EDITED
}

// ── BuyerProfile ──────────────────────────────────────────────────────────────

model BuyerProfile {
  id                     String       @id @default(cuid())
  contactId              String       @unique
  contact                Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id])

  priceMinCents          BigInt?
  priceMaxCents          BigInt?
  bedroomsMin            Int?
  bathroomsMin           Decimal?     @db.Decimal(3, 1)
  neighborhoods          String[]
  notes                  String?      @db.Text

  preApproved            Boolean      @default(false)
  preApprovalLender      String?
  preApprovalAmountCents BigInt?
  preApprovalCreditScore Int?
  preApprovalNotes       String?      @db.Text
  preApprovalExpiresAt   DateTime?

  timelineLabel          String?

  currentHomeClosingDate DateTime?    @db.Date
  currentHomeNote        String?

  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([organizationId])
}

// ── AiInsight ─────────────────────────────────────────────────────────────────

model AiInsight {
  id               String          @id @default(cuid())
  contactId        String
  contact          Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])

  type             InsightType
  priority         InsightPriority @default(NORMAL)
  reason           String          @db.Text
  suggestedMessage String          @db.Text

  status             InsightStatus   @default(PENDING)
  actedAt            DateTime?
  dismissedAt        DateTime?
  manuallyEdited     Boolean         @default(false)
  generationAttempts Int             @default(0)
  ownerClerkUserId   String?

  generatedAt        DateTime        @default(now())
  expiresAt          DateTime?

  @@index([organizationId, status, priority])
  @@index([contactId, status])
  @@index([organizationId, ownerClerkUserId, status])
}
